# ─────────────────────────────────────────────
#  의존성 / 빌드 결과물 — 각자 설치하므로 올리지 않음
# ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ─────────────────────────────────────────────
#  편집기 · OS 설정 — 사람마다 다르므로 올리지 않음
# ─────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# ─────────────────────────────────────────────
#  비밀 정보 — 절대 올리지 말 것
#  DB 비밀번호, API 키 등은 .env 에만 두고
#  .env.example 에 "키 이름만" 적어 공유한다
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─────────────────────────────────────────────
#  데이터 — 용량이 크고 재배포가 제한됨
#  AI Hub 감성대화 말뭉치는 각자 내려받을 것
# ─────────────────────────────────────────────
*.xlsx
*.xls
*.zip
*.tar
*.tar.gz
data/raw/
model/data/

# 단, 프론트 개발용 더미 데이터는 올린다 (25KB, 받자마자 화면 확인 가능)
!frontend/src/data/dummy.json

# ─────────────────────────────────────────────
#  모델 가중치 · 학습 산출물 — 용량이 큼
#  학습된 모델은 Hugging Face Hub 등으로 공유한다
# ─────────────────────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
checkpoints/
runs/
wandb/

# ─────────────────────────────────────────────
#  분석 결과 · 업로드 파일 — 개인정보가 섞일 수 있음
# ─────────────────────────────────────────────
uploads/
outputs/
*.db
*.sqlite3

# ─────────────────────────────────────────────
#  로그 · 임시 파일
# ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
.ipynb_checkpoints/
